  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.3 对比损失 (InfoNCE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算相似度矩阵\n",
    "similarity = clip_model.get_similarity(image_features, text_features)\n",
    "print(f'相似度矩阵形状: {similarity.shape}')\n",
    "\n",
    "# 可视化相似度矩阵\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.imshow(similarity.cpu().numpy(), cmap='RdYlBu_r', vmin=-1, vmax=1)\n",
    "plt.colorbar(label='余弦相似度')\n",
    "plt.xlabel('文本索引')\n",
    "plt.ylabel('图像索引')\n",
    "plt.title('CLIP 图文相似度矩阵\\n(对角线应该最大)')\n",
    "\n",
    "# 标注对角线\n",
    "for i in range(batch_size):\n",
    "    plt.plot(i, i, 'ko', markersize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算对比损失\n",
    "loss = clip_loss(image_features, text_features, logit_scale)\n",
    "print(f'CLIP 对比损失: {loss.item():.4f}')\n",
    "\n",
    "# 分解损失\n",
    "logits_per_image = logit_scale.exp() * image_features @ text_features.t()\n",
    "logits_per_text = logits_per_image.t()\n",
    "labels = torch.arange(batch_size, device=device)\n",
    "\n",
    "loss_i2t = F.cross_entropy(logits_per_image, labels)\n",
    "loss_t2i = F.cross_entropy(logits_per_text, labels)\n",
    "\n",
    "print(f'图像到文本损失: {loss_i2t.item():.4f}')\n",
    "print(f'文本到图像损失: {loss_t2i.item():.4f}')\n",
    "print(f'平均损失: {(loss_i2t + loss_t2i).item() / 2:.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# InfoNCE 损失公式可视化\n",
    "def visualize_infonce():\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    \n",
    "    # 左图: 相似度矩阵\n",
    "    sim = similarity.cpu().numpy()\n",
    "    im = axes[0].imshow(sim, cmap='RdYlBu_r')\n",
    "    axes[0].set_title('相似度矩阵 S = I @ T.T')\n",
    "    axes[0].set_xlabel('文本')\n",
    "    axes[0].set_ylabel('图像')\n",
    "    plt.colorbar(im, ax=axes[0])\n",
    "    \n",
    "    # 右图: Softmax 后的概率\n",
    "    probs = F.softmax(logits_per_image, dim=-1).cpu().numpy()\n",
    "    im = axes[1].imshow(probs, cmap='Blues')\n",
    "    axes[1].set_title('Softmax 概率 P = softmax(S/τ)\\n(每行应该在对角线位置最大)')\n",
    "    axes[1].set_xlabel('文本')\n",
    "    axes[1].set_ylabel('图像')\n",
    "    plt.colorbar(im, ax=axes[1])\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "visualize_infonce()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.4 零样本分类"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def zero_shot_classify(model, image_features, class_embeddings, class_names):\n",
    "    \"\"\"\n",
    "    零样本分类\n",
    "    \n",
    "    Args:\n",
    "        model: CLIP 模型\n",
    "        image_features: 图像特征 [B, D]\n",
    "        class_embeddings: 类别文本特征 [C, D]\n",
    "        class_names: 类别名称列表\n",
    "    \n",
    "    Returns:\n",
    "        predictions: 预测类别索引\n",
    "        probabilities: 预测概率\n",
    "    \"\"\"\n",
    "    # 计算相似度\n",
    "    similarity = image_features @ class_embeddings.T\n",
    "    \n",
    "    # 转换为概率\n",
    "    probabilities = F.softmax(similarity * 100, dim=-1)\n",
    "    \n",
    "    # 获取预测\n",
    "    predictions = probabilities.argmax(dim=-1)\n",
    "    \n",
    "    return predictions, probabilities\n",
    "\n",
    "# 模拟类别嵌入\n",
    "class_names = ['猫', '狗', '鸟', '汽车', '飞机', '船', '自行车', '马']\n",
    "num_classes = len(class_names)\n",
    "class_embeddings = F.normalize(torch.randn(num_classes, clip_model.config.embed_dim).to(device), dim=-1)\n",
    "\n",
    "# 零样本分类\n",
    "predictions, probabilities = zero_shot_classify(clip_model, image_features, class_embeddings, class_names)\n",
    "\n",
    "print('零样本分类结果:')\n",
    "for i in range(min(4, batch_size)):\n",
    "    pred_class = class_names[predictions[i]]\n",
    "    pred_prob = probabilities[i, predictions[i]].item()\n",
    "    print(f'  图像 {i}: 预测类别 = {pred_class}, 置信度 = {pred_prob:.2%}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 可视化分类概率分布\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i in range(4):\n",
    "    probs = probabilities[i].cpu().numpy()\n",
    "    colors = ['green' if j == predictions[i] else 'steelblue' for j in range(num_classes)]\n",
    "    \n",
    "    axes[i].barh(class_names, probs, color=colors)\n",
    "    axes[i].set_xlabel('概率')\n",
    "    axes[i].set_title(f'图像 {i} 的分类概率')\n",
    "    axes[i].set_xlim(0, 1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.5 图文检索"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def image_to_text_retrieval(image_features, text_features, k=5):\n",
    "    \"\"\"\n",
    "    图像到文本检索\n",
    "    \n",
    "    Args:\n",
    "        image_features: 图像特征 [N, D]\n",
    "        text_features: 文本特征 [M, D]\n",
    "        k: 返回 top-k 结果\n",
    "    \n",
    "    Returns:\n",
    "        indices: 检索结果索引 [N, k]\n",
    "        scores: 相似度分数 [N, k]\n",
    "    \"\"\"\n",
    "    similarity = image_features @ text_features.T\n",
    "    scores, indices = similarity.topk(k, dim=-1)\n",
    "    return indices, scores\n",
    "\n",
    "def text_to_image_retrieval(text_features, image_features, k=5):\n",
    "    \"\"\"\n",
    "    文本到图像检索\n",
    "    \"\"\"\n",
    "    similarity = text_features @ image_features.T\n",
    "    scores, indices = similarity.topk(k, dim=-1)\n",
    "    return indices, scores\n",
    "\n",
    "# 图像到文本检索\n",
    "i2t_indices, i2t_scores = image_to_text_retrieval(image_features, text_features, k=3)\n",
    "print('图像到文本检索结果:')\n",
    "for i in range(min(3, batch_size)):\n",
    "    print(f'  图像 {i} -> 文本 {i2t_indices[i].tolist()}, 分数 {i2t_scores[i].tolist()}')\n",
    "\n",
    "print()\n",
    "\n",
    "# 文本到图像检索\n",
    "t2i_indices, t2i_scores = text_to_image_retrieval(text_features, image_features, k=3)\n",
    "print('文本到图像检索结果:')\n",
    "for i in range(min(3, batch_size)):\n",
    "    print(f'  文本 {i} -> 图像 {t2i_indices[i].tolist()}, 分数 {t2i_scores[i].tolist()}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算检索指标\n",
    "def compute_recall_at_k(similarity, k_values=[1, 5, 10]):\n",
    "    \"\"\"\n",
    "    计算 Recall@K\n",
    "    \"\"\"\n",
    "    N = similarity.shape[0]\n",
    "    results = {}\n",
    "    \n",
    "    for k in k_values:\n",
    "        if k > N:\n",
    "            continue\n",
    "        # 获取 top-k 索引\n",
    "        _, topk_indices = similarity.topk(k, dim=-1)\n",
    "        \n",
    "        # 检查正确答案是否在 top-k 中\n",
    "        correct = torch.arange(N, device=similarity.device).unsqueeze(1)\n",
    "        hits = (topk_indices == correct).any(dim=-1).float()\n",
    "        \n",
    "        results[f'R@{k}'] = hits.mean().item() * 100\n",
    "    \n",
    "    return results\n",
    "\n",
    "# 计算检索指标\n",
    "i2t_sim = image_features @ text_features.T\n",
    "t2i_sim = text_features @ image_features.T\n",
    "\n",
    "i2t_recall = compute_recall_at_k(i2t_sim, k_values=[1, 3, 5])\n",
    "t2i_recall = compute_recall_at_k(t2i_sim, k_values=[1, 3, 5])\n",
    "\n",
    "print('图像到文本检索指标:')\n",
    "for k, v in i2t_recall.items():\n",
    "    print(f'  {k}: {v:.1f}%')\n",
    "\n",
    "print('\\n文本到图像检索指标:')\n",
    "for k, v in t2i_recall.items():\n",
    "    print(f'  {k}: {v:.1f}%')"
   ]
