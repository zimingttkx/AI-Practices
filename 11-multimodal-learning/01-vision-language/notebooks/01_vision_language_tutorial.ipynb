  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 准备模拟数据\n",
    "batch_size = 8\n",
    "images = torch.randn(batch_size, 3, 224, 224).to(device)\n",
    "input_ids = torch.randint(0, 49408, (batch_size, 77)).to(device)\n",
    "\n",
    "print(f'图像输入形状: {images.shape}')\n",
    "print(f'文本输入形状: {input_ids.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 前向传播\n",
    "with torch.no_grad():\n",
    "    image_features, text_features, logit_scale = clip_model(images, input_ids)\n",
    "\n",
    "print(f'图像特征形状: {image_features.shape}')\n",
    "print(f'文本特征形状: {text_features.shape}')\n",
    "print(f'Logit scale: {logit_scale.item():.4f}')\n",
    "print(f'温度参数 τ: {1/logit_scale.exp().item():.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 验证特征已归一化\n",
    "image_norms = torch.norm(image_features, dim=-1)\n",
    "text_norms = torch.norm(text_features, dim=-1)\n",
    "\n",
    "print(f'图像特征 L2 范数: {image_norms.mean().item():.4f} (应接近 1.0)')\n",
    "print(f'文本特征 L2 范数: {text_norms.mean().item():.4f} (应接近 1.0)')"
   ]
