   "source": [
    "## 3. BLIP 多任务学习\n",
    "\n",
    "BLIP 支持三种任务：ITC（对比）、ITM（匹配）、LM（生成）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建 BLIP 模型\n",
    "blip_model = create_blip_model('small')\n",
    "blip_model = blip_model.to(device)\n",
    "\n",
    "print('=== BLIP 模型结构 ===')\n",
    "print(f'总参数量: {sum(p.numel() for p in blip_model.parameters()):,}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 准备输入\n",
    "images = torch.randn(4, 3, 224, 224).to(device)\n",
    "input_ids = torch.randint(0, 30522, (4, 32)).to(device)\n",
    "\n",
    "# ITC 任务\n",
    "with torch.no_grad():\n",
    "    image_feat, text_feat, logit_scale = blip_model.forward_itc(images, input_ids)\n",
    "    loss_itc = itc_loss(image_feat, text_feat, logit_scale)\n",
    "\n",
    "print(f'ITC - 图像特征: {image_feat.shape}, 文本特征: {text_feat.shape}')\n",
    "print(f'ITC 损失: {loss_itc.item():.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ITM 任务\n",
    "with torch.no_grad():\n",
    "    itm_logits = blip_model.forward_itm(images, input_ids)\n",
    "    labels = torch.ones(4, dtype=torch.long).to(device)\n",
    "    loss_itm_val = itm_loss(itm_logits, labels)\n",
    "\n",
    "print(f'ITM logits: {itm_logits.shape}')\n",
    "print(f'ITM 损失: {loss_itm_val.item():.4f}')\n",
    "print(f'匹配概率: {F.softmax(itm_logits, dim=-1)[:, 1].tolist()}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# LM 任务 - 图像描述生成\n",
    "with torch.no_grad():\n",
    "    generated = blip_model.generate(images[:1], max_length=20)\n",
    "\n",
    "print(f'生成序列形状: {generated.shape}')\n",
    "print(f'生成的 token IDs: {generated[0].tolist()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
