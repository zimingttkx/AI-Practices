# EditorConfig configuration
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,ts,jsx,tsx,mjs,mts,cjs,cts}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{ipynb}]
indent_size = 1
insert_final_newline = false

[*.sh]
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab

[*.{toml,ini,cfg}]
indent_size = 4

[*.{html,css,scss}]
indent_size = 2
